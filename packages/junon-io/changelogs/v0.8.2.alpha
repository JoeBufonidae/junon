{
  "version": "v0.8.2.alpha",
  "date": "November 3, 2026",
  "title": "Lots of Bugs Squashed, and more - by BigTforLife",
  "content": {
    "features": [
      "Revert katana sprite changes",
      "Reduced raven and drone damage",
      "Made raven shoot 4 times slower",
      "Renabled global chat, and added hide global chat setting",
      "Increased role limit to 1000",
      "Added /sound command (playsound still available for legacy)",
      "Added alot of sounds for /sound",
      "Added some variations of words to bad word list",
      "Added $variables variable that list the names of all created variables",
      "Reduced craft cost of rail track",
      "Changed default floor to the nicer looking cornered white 1",
      "Added /zoom command to set player zoom level",
      "Added minZoom, maxZoom, fovRange, and fovImmunity stats for players",
      "Increased default fovRange by alot",
      "Added $getZoom, $getMinZoom, $getMaxZoom",
      "Reworked homepage a bit (temporary, improvements coming soon)",
      "Added some analytics to help understand the player base better"
    ],
    "bugs": [
      "Now for the bugs squashed (30 by me, 3 by wahlee)",
      "First, from Wahlee:",
      "Fixed trams derailing derailing once reaching stop",
      "Fixed ItemPickup trigger returning 0",
      "Fixed save formats",
      "Now BigT Bugs:",
      "Fixed fire extinguisher spray being too close to the body",
      "Fixed /killing windows leaving low walls behind",
      "Fixed corpses not being flammable after being lit and extinguished",
      "Fixed miasma gate having too big of a hitbox",
      "Fixed miasma gate not clearing corpse miasma",
      "Fixed issues with players appearing when joining while FOV mode on",
      "Fixed entities not reappearing when FOV turned off",
      "Fixed entities out of sight not disappearing when FOV turned on",
      "Fixed FOV bugs with mobs",
      "Fixed hands not resetting for gun animations when switched to another slot",
      "Fixed deconstructed buildings leaving behind sky on minimap",
      "Fixed closing bracket in command arguements",
      "Fixed keyboard $key not returning proper keys",
      "Fixed mobs with poison immunity still getting poison effect",
      "Fixed being able to change the color of other players suits",
      "Fixed < > being converted in sign formats",
      "Fixed sounds played with commands building up in storage",
      "Fixed windows not being airtight",
      "Fixed gold stacking above 99",
      "Fixed projectile help not displaying when typing the plain command",
      "Fixed terminal ignoring being unpowered",
      "Fixed web trap effect not being cleared by /effect clear paralyze",
      "Fixed fires on rock burning forever if the world was unloaded before they went out",
      "Fixed mob names not updating on client till the mob moved",
      "Fixed flying mobs firing while over impassible obstacles",
      "Fixed being able to craft from crafting stations while not near the required station"
    ]
  }
}
